## 7. Hyperparameter Tuning <a id='7-Hyperparameter-Tuning'></a>

```python
# Hyperparameter tuning for Logistic Regression (best performing model)
print("🎯 Performing hyperparameter tuning for Logistic Regression...")

# Create pipeline
pipeline_lr = Pipeline([
    ('tfidf', TfidfVectorizer(max_features=5000, ngram_range=(1, 2), min_df=5, max_df=0.7)),
    ('classifier', LogisticRegression(random_state=42))
])

# Parameter grid
param_grid_lr = {
    'tfidf__max_features': [3000, 5000, 7000],
    'tfidf__ngram_range': [(1, 1), (1, 2)],
    'classifier__C': [0.1, 1, 10, 100],
    'classifier__penalty': ['l1', 'l2'],
    'classifier__solver': ['liblinear']
}

# Grid search
grid_search_lr = GridSearchCV(
    pipeline_lr,
    param_grid_lr,
    cv=5,
    scoring='f1',
    n_jobs=-1,
    verbose=1
)

# Fit grid search
grid_search_lr.fit(X_train, y_train)

print(f"✅ Best parameters: {grid_search_lr.best_params_}")
print(f"✅ Best F1 score: {grid_search_lr.best_score_:.4f}")

# Evaluate best model
best_model_lr = grid_search_lr.best_estimator_
y_pred_lr = best_model_lr.predict(X_test)
y_pred_proba_lr = best_model_lr.predict_proba(X_test)[:, 1]

print("\n📊 Best Logistic Regression Model Performance:")
print(classification_report(y_test, y_pred_lr, target_names=['Non-Disaster', 'Disaster']))

# Save best model
joblib.dump(best_model_lr, '../model/best_logistic_regression.pkl')
print("✅ Best model saved to ../model/best_logistic_regression.pkl")
```

