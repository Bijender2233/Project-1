## 3. Text Preprocessing <a id='3-Text-Preprocessing'></a>

```python
class TextPreprocessor:
    """Class for text preprocessing operations."""
    
    def __init__(self):
        self.lemmatizer = WordNetLemmatizer()
        self.stop_words = set(stopwords.words('english'))
    
    def clean_text(self, text):
        """Clean and preprocess text for NLP tasks."""
        if not isinstance(text, str):
            return ""
        
        # Convert to lowercase
        text = text.lower()
        
        # Remove URLs
        text = re.sub(r'http\S+|www\S+|https\S+', '', text, flags=re.MULTILINE)
        
        # Remove user mentions and hashtags
        text = re.sub(r'\@\w+|\#\w+', '', text)
        
        # Remove punctuation
        text = text.translate(str.maketrans('', '', string.punctuation))
        
        # Remove numbers
        text = re.sub(r'\d+', '', text)
        
        # Tokenize
        tokens = word_tokenize(text)
        
        # Remove stopwords and lemmatize
        tokens = [self.lemmatizer.lemmatize(word) for word in tokens if word not in self.stop_words]
        
        # Join tokens back to string
        cleaned_text = ' '.join(tokens)
        
        return cleaned_text

# Initialize preprocessor
preprocessor = TextPreprocessor()

# Test preprocessing on sample tweets
sample_tweets = [
    "Earthquake hits California! #earthquake #disaster https://example.com",
    "@user Just had a great lunch with friends at #restaurant",
    "Forest fire spreading rapidly, evacuate immediately!!!",
    "The weather is nice today, 25 degrees and sunny"
]

print("🧹 Text Preprocessing Examples:")
for tweet in sample_tweets:
    cleaned = preprocessor.clean_text(tweet)
    print(f"Original:  {tweet}")
    print(f"Cleaned:   {cleaned}")
    print()
```

