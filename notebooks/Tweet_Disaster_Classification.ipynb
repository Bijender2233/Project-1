## 8. Model Deployment <a id='8-Model-Deployment'></a>

```python
# Create a simple prediction function
class TweetDisasterPredictor:
    """A simple class for making predictions on new tweets."""
    
    def __init__(self, model_path=None):
        if model_path:
            self.model = joblib.load(model_path)
        else:
            self.model = best_model_lr  # Use the best model from tuning
        self.preprocessor = TextPreprocessor()
    
    def predict(self, text):
        """Predict if a tweet is about a disaster."""
        if isinstance(text, str):
            texts = [text]
        else:
            texts = text
        
        # Preprocess
        cleaned_texts = [self.preprocessor.clean_text(t) for t in texts]
        
        # Predict
        predictions = self.model.predict(cleaned_texts)
        probabilities = self.model.predict_proba(cleaned_texts)
        
        results = []
        for i, (text, pred, prob) in enumerate(zip(texts, predictions, probabilities)):
            result = {
                'text': text,
                'prediction': 'Disaster' if pred == 1 else 'Non-Disaster',
                'confidence': prob[1] if pred == 1 else prob[0],
                'probability': prob[1]
            }
            results.append(result)
        
        return results[0] if len(results) == 1 else results
    
    def predict_batch(self, texts):
        """Predict on a batch of tweets."""
        return self.predict(texts)

# Initialize predictor
predictor = TweetDisasterPredictor()
print("✅ Predictor initialized with best model")
```

